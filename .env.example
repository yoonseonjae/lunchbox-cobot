# ==============================================================================
# 환경변수 설정 예시 (각자 환경에 맞게 복사해서 사용하세요)
# ==============================================================================
# 1. 이 파일을 복사합니다: cp .env.example .env
# 2. .env 파일의 경로를 본인 환경에 맞게 수정합니다.
# 3. 아래 명령으로 환경변수를 적용합니다:
#    source .env  또는  set -a && source .env && set +a
# ==============================================================================

# cobot_ws/src 디렉터리의 절대 경로
# robot_dashboard.py, motion_sim.py 에서 URDF 파일 및 웹 파일 경로로 사용됩니다.
export COBOT_WS_SRC=/home/<user>/cobot_ws/src

# Firebase 서비스 계정 키 파일의 절대 경로
# user_order_app.py 에서 Firebase 인증에 사용됩니다.
export SERVICE_ACCOUNT_KEY_PATH=/home/<user>/cobot_ws/src/cobot1/config/serviceAccountKey.json
